# Copy to .env for local dev; set the same variables in Railway for production.

# MongoDB Atlas: either the full connection string...
MONGODB_URI=
# ...or the parts (the password is URL-encoded for you in app/services/mongo.py)
MONGO_USER=
MONGO_PASS=
MONGO_CLUSTER=
MONGO_APP=DormMate0

# Comma-separated frontend URLs allowed by CORS. Leave unset for "*" in local dev.
ALLOWED_ORIGINS=
