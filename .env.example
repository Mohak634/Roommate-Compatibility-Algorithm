# Copy to .env for local dev; set the same variables in Railway for production.

# MongoDB: a full connection string (Atlas or local, e.g. mongodb://localhost:27017)...
MONGODB_URI=
# ...or Atlas parts (the password is URL-encoded for you)
MONGO_USER=
MONGO_PASS=
MONGO_CLUSTER=
MONGO_APP=DormMate0
MONGO_DB=dormmate
# MONGODB_URI=mongomock:// runs an in-memory database (needs requirements-dev.txt)

# Signs login tokens. Required in production: a long random string,
# e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Password for the demo account created by scripts/seed.py
DEMO_PASSWORD=dormmate-demo

# Comma-separated frontend URLs allowed by CORS. Leave unset for "*" in local dev.
ALLOWED_ORIGINS=

# Private path to the real survey CSV, for scripts/evaluate_matching.py and
# scripts/generate_profiles.py only. Never commit the file.
DORMMATE_SURVEY_CSV=
